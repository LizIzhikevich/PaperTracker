{
  "name": "paper-tracker",
  "version": "0.1.10",
  "description": "A local-first desktop paper workflow tracker for macOS and Windows.",
  "main": "src/main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer/app.js",
    "dist": "pnpm check && electron-builder --publish=never",
    "dist:mac": "pnpm run package:mac",
    "package:mac": "pnpm check && electron-builder --mac --publish=never",
    "dist:win": "electron-builder --win --publish=never"
  },
  "keywords": [
    "electron",
    "papers",
    "research",
    "local-first"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "pdf-parse": "1.1.1"
  },
  "build": {
    "appId": "edu.ucla.papertracker",
    "productName": "PaperTracker",
    "asar": true,
    "asarUnpack": [
      "node_modules/onnxruntime-node/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/papertracker-icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LizIzhikevich",
        "repo": "PaperTracker",
        "releaseType": "release"
      }
    ]
  }
}
